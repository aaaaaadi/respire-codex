{
  "description": "Respire uses the existing host rsrs runtime; review these hooks before trusting them.",
  "hooks": {
    "SessionStart": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"import(require('node:url').pathToFileURL(process.env.PLUGIN_ROOT+'/lib/hook.js')).then(m=>m.main())\"",
      "timeout": 30,
      "additionalContextLimit": 2000,
      "statusMessage": "Checking Respire memory"
    }] }],
    "UserPromptSubmit": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"import(require('node:url').pathToFileURL(process.env.PLUGIN_ROOT+'/lib/hook.js')).then(m=>m.main())\"",
      "timeout": 30,
      "additionalContextLimit": 2000,
      "statusMessage": "Recalling Respire memory"
    }] }],
    "Stop": [{ "hooks": [{
      "type": "command",
      "command": "node -e \"import(require('node:url').pathToFileURL(process.env.PLUGIN_ROOT+'/lib/hook.js')).then(m=>m.main())\"",
      "async": true,
      "timeout": 300,
      "statusMessage": "Organizing Respire memory in background"
    }] }]
  }
}
